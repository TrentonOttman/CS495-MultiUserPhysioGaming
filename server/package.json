{
  "private": true,
  "name": "server",
  "version": "0.1.0",
  "description": "A Colyseus multiplayer server",
  "type": "module",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "vite",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "vite build",
    "clean": "rimraf dist",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000",
    "dev": "vite",
    "build:client": "vite build --mode client"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "@types/node": "^22.13.13",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@colyseus/playground": "^0.18.3",
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.1",
    "colyseus": "^0.18.2",
    "express": "^5.2.1"
  }
}
